{
  "name": "Study Bud",
  "description": "Study buddy that keeps you focused.",
  "version": "1.0",
  "manifest_version": 3,
    "background":{
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "catpic.png"
  },
  "permissions": [
    "alarms", "storage", "notifications", "declarativeNetRequest"
  ]

}